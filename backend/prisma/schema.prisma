generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  jobTitle   String
  department String
  country    String
  currency   String   @default("USD")
  salary     Float
  hireDate   DateTime
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([country])
  @@index([jobTitle])
  @@index([department])
  @@index([status])
  @@index([country, jobTitle])
}
